# ==============================================================================
# Lenny Growth Assistant - Environment Configuration Template
# NOTE: Do NOT commit secrets or real credentials to source control.
# Copy this file to .env and fill in the values for local development.
# ==============================================================================

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny_growth

# Knowledge Base / Transcript Storage
TRANSCRIPTS_DIR=data/transcripts

# LLM Provider Configuration ('ollama' or 'anthropic')
LLM_PROVIDER=ollama

# Local LLM (Ollama) - Mandatory for Demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TIMEOUT_SECONDS=30.0

# Cloud LLM (Anthropic Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TIMEOUT_SECONDS=30.0

# Agent & Grounded Chat Settings
CHAT_SEARCH_LIMIT=4
MAX_HISTORY_TURNS=6

# Frontend Service (Vite)
VITE_API_BASE_URL=http://localhost:8000
PORT=5173
